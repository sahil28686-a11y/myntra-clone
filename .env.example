# =============================================================================
# Myntra Clone — Development Environment Variables (Medusa v2)
# =============================================================================
# Copy to backend/.env for local development:
#   cp .env.example backend/.env
# =============================================================================

# --- Database ---
DATABASE_URL=postgres://myntra:myntra_pass@localhost:5432/myntra_store

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT & Cookies (v2 required) ---
JWT_SECRET=myntra-jwt-secret-change-in-production
COOKIE_SECRET=myntra-cookie-secret-change-in-production

# --- CORS (v2 required) ---
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# --- Payments: COD-only for this pass (§6.1) ---
# Razorpay keys are NOT used in this pass. Leave blank.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Telemetry ---
MEDUSA_DISABLE_TELEMETRY=true

# --- Storefront ---
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000