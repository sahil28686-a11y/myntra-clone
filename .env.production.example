# =============================================================================
# Myntra Clone — Production Environment Variables (Medusa v2)
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.production.example .env
#
# ⚠️  IMPORTANT: The default admin password is "admin123" (created by the seed
#     script). CHANGE IT IMMEDIATELY after first boot via the admin panel or:
#       docker compose -f docker-compose.prod.yml exec medusa \
#         npx medusa user -e admin@myntra-clone.com -p <new-password>
#
# Domain is deferred (§6.6). Replace myntra-clone.local with your real domain.
# =============================================================================

# --- Database (PostgreSQL 15) ---
POSTGRES_USER=myntra
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=myntra_store
# Full connection string used by Medusa v2 (medusa-config.ts → databaseUrl)
DATABASE_URL=postgres://myntra:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/myntra_store

# --- Redis ---
# Full connection string used by Medusa v2 (medusa-config.ts → redisUrl)
REDIS_URL=redis://redis:6379

# --- JWT & Session Secrets (v2 required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
COOKIE_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# --- CORS (v2 required) ---
# Storefront origin (where the Next.js storefront is served)
STORE_CORS=https://myntra-clone.local
# Admin origin (the admin subdomain — v2 admin app is served at /app on this origin)
ADMIN_CORS=https://admin.myntra-clone.local
# Auth CORS (v2 requires this — typically same as ADMIN_CORS)
AUTH_CORS=https://admin.myntra-clone.local

# --- Payments: COD-only for this pass (§6.1) ---
# Razorpay is NOT used in this deployment pass. No Razorpay keys are needed.
# To enable Razorpay later: add RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET here
# and integrate a v2-compatible Razorpay payment provider.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Storefront ---
NEXT_PUBLIC_MEDUSA_URL=https://api.myntra-clone.local

# --- Domain Configuration (replace with real domain at deploy time) ---
DOMAIN=myntra-clone.local
ADMIN_DOMAIN=admin.myntra-clone.local
API_DOMAIN=api.myntra-clone.local
UPLOADS_DOMAIN=uploads.myntra-clone.local

# --- Admin Credentials (first-run setup) ---
# The seed script creates admin@myntra-clone.com / admin123.
# ⚠️  Change this password immediately after first boot!
ADMIN_EMAIL=admin@myntra-clone.com
ADMIN_PASSWORD=admin123

# --- Docker Image Tags ---
MEDUSA_IMAGE_TAG=latest
STOREFRONT_IMAGE_TAG=latest

# --- Telemetry (optional) ---
MEDUSA_DISABLE_TELEMETRY=true

# --- Monitoring ---
# Sentry DSN (optional, deferred — not configured in this pass)
SENTRY_DSN=
# Log level: debug, info, warn, error
LOG_LEVEL=info