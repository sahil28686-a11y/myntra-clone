# =============================================================================
# Myntra Clone — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.production.example .env
# =============================================================================

# --- Database ---
POSTGRES_USER=myntra
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=myntra_store

# --- Redis ---
# Redis is configured with default settings. No env vars needed.

# --- JWT & Session Secrets ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
COOKIE_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# --- Razorpay (Payment) ---
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SendGrid (Transactional Emails) ---
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@myntra-clone.com

# --- CORS ---
STORE_CORS=https://myntra-clone.com
ADMIN_CORS=https://admin.myntra-clone.com

# --- Storefront ---
NEXT_PUBLIC_MEDUSA_URL=https://api.myntra-clone.com

# --- Domain Configuration ---
DOMAIN=myntra-clone.com
ADMIN_DOMAIN=admin.myntra-clone.com
API_DOMAIN=api.myntra-clone.com
UPLOADS_DOMAIN=uploads.myntra-clone.com

# --- Admin Credentials (first-run setup) ---
ADMIN_EMAIL=admin@myntra-clone.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Docker Image Tags ---
MEDUSA_IMAGE_TAG=latest
STOREFRONT_IMAGE_TAG=latest

# --- Monitoring ---
# Sentry DSN (optional)
SENTRY_DSN=
# Log level: debug, info, warn, error
LOG_LEVEL=info
